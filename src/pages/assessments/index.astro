---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import AssessmentsGrid from "../../components/AssessmentsGrid.astro";
import { siteConfig } from "../../site-config";
---

<ContentLayout
  title="Assessment"
  description="Every piece of graded work in the course, and what you need to pass."
  {...siteConfig}
>
  <p>
    The course is graded CRS (pass/fail) and does not count towards your
    GPA. To pass, you must pass Assignment 01, pass Assignment 02, and
    complete at least 8 of the 12 weekly syncs.
  </p>
  <AssessmentsGrid />
</ContentLayout>
