---
import { getCollection } from "astro:content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

// STARTER_CONTENT: replace the hero artwork and its alt text below, then
// remove this comment.

const lectures = (await getCollection("lectures")).sort((a, b) => a.data.week - b.data.week);

const units = [...new Map(lectures.map((lecture) => [lecture.data.unit, lecture.data.unitTitle])).entries()]
  .sort(([a], [b]) => Number(a) - Number(b))
  .map(([unit, unitTitle]) => {
    const weeks = lectures.filter((lecture) => lecture.data.unit === unit);
    return {
      unit,
      unitTitle,
      firstWeek: weeks[0].data.week,
      lastWeek: weeks[weeks.length - 1].data.week,
    };
  });
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Twelve weeks, each built around one specific way a cold email fails —
    a vague ask, a subject line that hides its own point, a follow-up that
    costs the reader twice for nothing. You will diagnose real emails
    against that taxonomy and rewrite them, building a portfolio of fixes
    and, by the midterm, an eye for exactly where an email goes wrong before
    you can articulate why. The semester ends with a one-page personal
    doctrine on what makes an email worth sending, defended against one you'd
    actually send yourself.
  </p>

  <h2>Course structure</h2>
  <p>
    Six units, taken in a single teaching period, available in both the
    summer and winter teaching periods as well as the standard semester.
    Each week pairs a one-hour lecture with a one-hour Weekly Sync. Graded
    CRS (pass/fail); it does not count toward GPA.
  </p>
  <ol class="unit-list">
    {
      units.map((u) => (
        <li>
          <strong>Unit {u.unit}: {u.unitTitle}</strong> — weeks {u.firstWeek}–{u.lastWeek}
        </li>
      ))
    }
  </ol>

  <h2>Who it is for</h2>
  <p>
    Anyone who has to get a stranger to read something and reply: founders
    doing outbound, students emailing for a reference or a chance at a role,
    anyone tired of writing "I hope this finds you well" and meaning none of
    it. No prior coursework is assumed. What's assumed is that you've sent an
    email that never got a reply and would like to know why.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The tutor-led hour and exercises attached to each week's lecture.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .unit-list {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    margin-block: 1.5rem 2rem;
  }
</style>
