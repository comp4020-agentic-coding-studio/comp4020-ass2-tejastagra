---
import { getCollection } from "astro:content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

// STARTER_CONTENT: replace the hero artwork and its alt text below, then
// remove this comment.

const lectures = (await getCollection("lectures")).sort((a, b) => a.data.week - b.data.week);

const blocks = [...new Map(lectures.map((lecture) => [lecture.data.block, lecture.data.blockTitle])).entries()]
  .sort(([a], [b]) => Number(a) - Number(b))
  .map(([block, blockTitle]) => {
    const weeks = lectures.filter((lecture) => lecture.data.block === block);
    return {
      block,
      blockTitle,
      firstWeek: weeks[0].data.week,
      lastWeek: weeks[weeks.length - 1].data.week,
    };
  });
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <p>
    The convenor tends to call it "Nobody Owes You a Reply" in conversation;
    that isn't the official title, but it's closer to the point.
  </p>

  <h2>What you will do</h2>
  <p>
    Twelve weeks, each built around one specific way a cold email fails —
    a vague ask, a subject line that hides its own point, a follow-up that
    costs the reader twice for nothing. You will diagnose real emails
    against that taxonomy and rewrite them, building a portfolio of fixes
    and, by the midterm, an eye for exactly where an email goes wrong before
    you can articulate why. The semester ends with a one-page personal
    doctrine on what makes an email worth sending, defended against one you'd
    actually send yourself.
  </p>

  <h2>Course structure</h2>
  <p>
    3 credits, taken in a single teaching period. Runs in the summer and
    winter non-standard teaching periods. Each week pairs a one-hour lecture
    (Mondays, 11am–12pm) with a one-hour Weekly Sync — two contact hours a
    week. Graded CRS (pass/fail); it does not count toward GPA.
  </p>
  <ol class="block-list">
    {
      blocks.map((b) => (
        <li>
          <strong>Block {b.block}: {b.blockTitle}</strong> — weeks {b.firstWeek}–{b.lastWeek}
        </li>
      ))
    }
  </ol>

  <p>
    There are three assessments — see the <a href={withBase("/assessments/")}>assessment
    page</a> for the brief, weighting, and due dates of each.
  </p>

  <h3>Weekly Sync timetable</h3>
  <p>Each Weekly Sync is run by one of the three tutors:</p>
  <table class="sync-timetable">
    <thead>
      <tr>
        <th scope="col">Tutor</th>
        <th scope="col">Day</th>
        <th scope="col">Time</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><a href={withBase("/people/bodhi-kessler-nakamura/")}>Bodhi Kessler-Nakamura</a></td>
        <td>Tuesday</td>
        <td>2pm–3pm</td>
      </tr>
      <tr>
        <td><a href={withBase("/people/marcus-ondieki/")}>Marcus Ondieki</a></td>
        <td>Wednesday</td>
        <td>10am–11am</td>
      </tr>
      <tr>
        <td><a href={withBase("/people/naomi-reyes/")}>Naomi Reyes</a></td>
        <td>Thursday</td>
        <td>4pm–5pm</td>
      </tr>
    </tbody>
  </table>

  <p>
    For help, email <a href="mailto:SLOP3089@slop.university">SLOP3089@slop.university</a>
    or use the Canvas page.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone who has to get a stranger to read something and reply: founders
    doing outbound, students emailing for a reference or a chance at a role,
    anyone tired of writing "I hope this finds you well" and meaning none of
    it. No prior coursework is assumed. What's assumed is that you've sent an
    email that never got a reply and would like to know why.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The tutor-led hour and exercises attached to each week's lecture.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
    <Card title="Lectures" href="/lectures/">
      <p>The full teaching content, week by week.</p>
    </Card>
    <Card title="Policies" href="/policies/">
      <p>Extensions, academic integrity, and the rest of the fine print.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .block-list {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    margin-block: 1.5rem 2rem;
  }

  .sync-timetable {
    width: 100%;
    border-collapse: collapse;
    margin-block: 1rem 2rem;
  }

  .sync-timetable th,
  .sync-timetable td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--at-border, #d0d0d0);
  }
</style>
