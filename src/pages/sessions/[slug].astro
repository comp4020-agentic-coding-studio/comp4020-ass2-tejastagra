---
import { render } from "astro:content";
import { getPublishedCollection, getRelatedEntries } from "astro-course-university/content";
import type { GraphEntry } from "astro-course-university/content";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../../lib/dates";
import { relatedLinkText } from "../../lib/related";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
const related = await getRelatedEntries(session, graphCollections);
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p><strong>{formatCourseDate(session.data.date)}</strong></p>
  <Content />
  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <aside class="related-content" aria-label="Related">
    <h2>Related</h2>
    <ul>
      {
        related.map((e: GraphEntry) => (
          <li>
            <a href={withBase(`/${e.collection}/${e.id}/`)}>{relatedLinkText(e)}</a>
          </li>
        ))
      }
      <li>
        <a href={withBase("/assessments/")}>Assessment</a>
      </li>
    </ul>
  </aside>
</ContentLayout>

<style>
  .related-content {
    margin-block-start: 3rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .related-content h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-content ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
