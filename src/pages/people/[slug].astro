---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (instructor|convenor|tutor|guest|other) to display labels
// rather than rendering the raw lowercase value. The frontmatter value stays
// "instructor" (spec/course-content.test.ts checks for it); only the label
// shown to readers reads "Course Convenor and Lecturer".
const roleLabels: Record<string, string> = {
  instructor: "Course Convenor and Lecturer",
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// The convenor's contact note is a fixed office-hours slot; tutors' notes
// are freer-form, so the label differs even though it's the same field.
const contactLabel = person.data.role === "instructor" ? "Office hours" : "Contact";
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title. It's kept for that (and for the SEO meta
// tag BaseLayout builds from it) but not shown on the page itself; the card
// header below carries the name and role instead.
const description = person.data.description;

// Fallback initials for people without a photo file yet, e.g. "Professor
// Tejas Tagra" -> "TT".
const initials = person.data.title
  .replace(/^(Dr\.|Professor|Prof\.)\s+/, "")
  .split(/\s+/)
  .filter(Boolean)
  .map((word) => word[0])
  .filter((letter): letter is string => Boolean(letter) && /[A-Za-z]/.test(letter))
  .slice(0, 2)
  .join("")
  .toUpperCase();
---

<ContentLayout title={person.data.title} description={description} mainAttrs={{ class: "person-page" }} {...siteConfig}>
  <div class="person-card">
    <div class="person-card__header">
      {
        person.data.photo ? (
          <Image src={person.data.photo} alt={photoAlt} width={112} height={112} class="person-card__photo" />
        ) : (
          <div class="person-card__photo person-card__photo--placeholder" aria-hidden="true">
            {initials}
          </div>
        )
      }
    </div>

    <dl class="person-card__fields">
      {
        roleLabel && (
          <div class="person-card__row">
            <dt>Role</dt>
            <dd>{roleLabel}</dd>
          </div>
        )
      }
      {
        person.data.affiliation && (
          <div class="person-card__row">
            <dt>Affiliation</dt>
            <dd>{person.data.affiliation}</dd>
          </div>
        )
      }
      {
        person.data.email && (
          <div class="person-card__row">
            <dt>Email</dt>
            <dd>
              <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
            </dd>
          </div>
        )
      }
      {
        person.data.url && (
          <div class="person-card__row">
            <dt>Web</dt>
            <dd>
              <a href={person.data.url}>{person.data.url}</a>
            </dd>
          </div>
        )
      }
      {
        person.data.contact && (
          <div class="person-card__row">
            <dt>{contactLabel}</dt>
            <dd>{person.data.contact}</dd>
          </div>
        )
      }
    </dl>
  </div>

  <div class="person-bio">
    <Content />
  </div>
</ContentLayout>

<style is:global>
  /* The page's own h1 (the person's name) is the single visible heading;
     the card below no longer repeats it. The auto-rendered lead paragraph
     is kept for the SEO description meta tag but not shown on the page,
     since the role (in the fields below) and the bio already say what the
     one-line description would have said. */
  main.person-page > p.lead {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<style>
  .person-card {
    margin-block: 0 2rem;
    overflow: hidden;
    border: 1px solid var(--at-divider);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-elevated);
    box-shadow: var(--at-shadow-md);
  }

  .person-card__header {
    display: flex;
    justify-content: center;
    padding: var(--at-spacing-lg);
  }

  .person-card__photo {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .person-card__photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--at-accent-soft);
    color: var(--at-accent);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .person-card__fields {
    margin: 0;
    border-top: 1px solid var(--at-divider);
  }

  .person-card__row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.65rem var(--at-spacing-lg);
  }

  .person-card__row:nth-child(odd) {
    background: var(--at-accent-soft);
  }

  .person-card__row dt {
    margin: 0;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--at-text-secondary, #555);
    white-space: nowrap;
  }

  .person-card__row dd {
    margin: 0;
    word-break: break-word;
  }

  @media (max-width: 30rem) {
    .person-card__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      padding-block: 0.5rem;
    }
  }
</style>
